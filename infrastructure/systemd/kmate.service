[Unit]
Description=K-Mate NestJS Service
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/var/www/k-mate/server
Environment=NODE_ENV=production
# (권장) 환경변수 파일을 쓰시는 경우
# EnvironmentFile=/etc/k-mate.env
ExecStart=/usr/bin/node dist/main.js
Restart=always
RestartSec=5
StandardOutput=syslog
StandardError=syslog

[Install]
WantedBy=multi-user.target
